[Unit]
Description=AWS File Upload Flask App
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/aws-upload-app
EnvironmentFile=/home/ec2-user/aws-upload-app/.env
ExecStart=/home/ec2-user/aws-upload-app/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile /var/log/flask-app/access.log \
    --error-logfile  /var/log/flask-app/error.log \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
